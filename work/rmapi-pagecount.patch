+// ledgerPageCount updates the page map when replacing a PDF of a different length.
+// It deliberately refuses unfamiliar content schemas instead of risking a partial map.
+func ledgerPageCount(contentBytes []byte, count int) ([]byte, error) {
+	var content map[string]interface{}
+	if err := json.Unmarshal(contentBytes, &content); err != nil {
+		return nil, err
+	}
+	oldFloat, ok := content["pageCount"].(float64)
+	if !ok || oldFloat < 1 {
+		return nil, fmt.Errorf("missing old page count")
+	}
+	old := int(oldFloat)
+	if float64(old) != oldFloat {
+		return nil, fmt.Errorf("invalid old page count")
+	}
+	cp, ok := content["cPages"].(map[string]interface{})
+	if !ok {
+		return nil, fmt.Errorf("missing cPages")
+	}
+	pages, ok := cp["pages"].([]interface{})
+	if !ok || len(pages) != old {
+		return nil, fmt.Errorf("cPages length mismatch")
+	}
+	original, ok := cp["original"].(map[string]interface{})
+	if !ok || original["value"] != oldFloat {
+		return nil, fmt.Errorf("cPages original mismatch")
+	}
+	if count < 1 {
+		return nil, fmt.Errorf("new PDF has no pages")
+	}
+	if count > old {
+		last, ok := pages[len(pages)-1].(map[string]interface{})
+		if !ok {
+			return nil, fmt.Errorf("invalid last page")
+		}
+		idx, ok := last["idx"].(map[string]interface{})
+		if !ok {
+			return nil, fmt.Errorf("invalid last page index")
+		}
+		value, ok := idx["value"].(string)
+		if !ok || value == "" {
+			return nil, fmt.Errorf("invalid last page index value")
+		}
+		timestamp, ok := idx["timestamp"].(string)
+		if !ok || timestamp == "" {
+			return nil, fmt.Errorf("invalid last page timestamp")
+		}
+		for i := old; i < count; i++ {
+			value += "a"
+			pages = append(pages, map[string]interface{}{
+				"id":    uuid.New().String(),
+				"idx":   map[string]interface{}{"timestamp": timestamp, "value": value},
+				"redir": map[string]interface{}{"timestamp": timestamp, "value": i},
+			})
+		}
+	} else if count < old {
+		pages = pages[:count]
+		lastOpened, ok := cp["lastOpened"].(map[string]interface{})
+		if ok {
+			found := false
+			for _, page := range pages {
+				if page.(map[string]interface{})["id"] == lastOpened["value"] {
+					found = true
+					break
+				}
+			}
+			if !found {
+				lastOpened["value"] = pages[0].(map[string]interface{})["id"]
+			}
+		}
+	}
+	cp["pages"] = pages
+	original["value"] = count
+	content["pageCount"] = count
+	content["originalPageCount"] = count
+	return json.Marshal(content)
+}
